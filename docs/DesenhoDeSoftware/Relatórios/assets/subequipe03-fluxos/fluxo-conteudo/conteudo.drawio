<mxfile host="app.diagrams.net">
  <diagram name="Fluxo - Conteudo" id="conteudo">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="260" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Pool -->
        <mxCell id="pool" value="Fluxo: Conteudo - Meu SUS Digital" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1120" height="220" as="geometry" />
        </mxCell>

        <!-- Lane: Usuario (unica raia) -->
        <mxCell id="lane_usuario" value="Usuario" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;" vertex="1" parent="pool">
          <mxGeometry x="0" y="30" width="1120" height="190" as="geometry" />
        </mxCell>

        <!-- Start event -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_usuario">
          <mxGeometry x="30" y="75" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Task 1 -->
        <mxCell id="t1" value="Fazer login com Gov.br" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="110" y="65" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Task 2 -->
        <mxCell id="t2" value="Selecionar 'Conteudos' no menu lateral" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="300" y="65" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Task 3 -->
        <mxCell id="t3" value="Selecionar um artigo (ex: Coronavirus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="490" y="65" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Task 4 -->
        <mxCell id="t4" value="Ler o conteudo do artigo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="680" y="65" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Task 5 -->
        <mxCell id="t5" value="Curtir ou compartilhar o artigo (opcional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="870" y="65" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- End event -->
        <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane_usuario">
          <mxGeometry x="1060" y="75" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Sequence flows -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="start" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t5" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
