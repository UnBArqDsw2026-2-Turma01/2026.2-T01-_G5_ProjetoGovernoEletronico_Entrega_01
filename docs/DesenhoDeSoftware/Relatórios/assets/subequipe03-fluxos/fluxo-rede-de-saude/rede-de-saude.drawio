<mxfile host="app.diagrams.net">
  <diagram name="Fluxo - Rede de Saude" id="rede-saude">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="260" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Pool -->
        <mxCell id="pool" value="Fluxo: Rede de Saude - Meu SUS Digital" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1420" height="220" as="geometry" />
        </mxCell>

        <!-- Lane: Usuario (unica raia, seguindo o exemplo da profa: um participante por raia) -->
        <mxCell id="lane_usuario" value="Usuario" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;" vertex="1" parent="pool">
          <mxGeometry x="0" y="30" width="1420" height="190" as="geometry" />
        </mxCell>

        <!-- Start event -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_usuario">
          <mxGeometry x="30" y="75" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Task 1 -->
        <mxCell id="t1" value="Fazer login com Gov.br" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="110" y="65" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Task 2 -->
        <mxCell id="t2" value="Selecionar 'Rede de Saude' no menu Minha Saude" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="300" y="65" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Task 3 -->
        <mxCell id="t3" value="Selecionar categoria de estabelecimento (ex: Maternidade)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="490" y="65" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Task 4 -->
        <mxCell id="t4" value="Visualizar mapa e lista de unidades proximas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="680" y="65" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gw1" value="Como continuar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffc0;strokeColor=#d6b656;" vertex="1" parent="lane_usuario">
          <mxGeometry x="870" y="60" width="80" height="70" as="geometry" />
        </mxCell>

        <!-- Task 5a -->
        <mxCell id="t5a" value="Visualizar endereco e servicos da unidade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="990" y="25" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- Task 5b -->
        <mxCell id="t5b" value="Abrir rota ate a unidade no Google Maps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_usuario">
          <mxGeometry x="990" y="115" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- End events -->
        <mxCell id="end1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane_usuario">
          <mxGeometry x="1200" y="35" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="end2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane_usuario">
          <mxGeometry x="1200" y="125" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Sequence flows -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="start" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t4" target="gw1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Detalhes" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="gw1" target="t5a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Ver no mapa" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="gw1" target="t5b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t5a" target="end1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="lane_usuario" source="t5b" target="end2"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
